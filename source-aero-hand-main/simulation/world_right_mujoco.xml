<mujoco model="aero_hand_right_world">
  <include file="models/aero_hand_open_right/aero_hand_open_right.xml"/>

  <statistic center="0 0 0.15" extent="0.6"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.1 0.18 0.28" rgb2="0.05 0.08 0.14" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.12 0.16 0.22" rgb2="0.08 0.11 0.16" width="512" height="512" mark="edge" markrgb="0.25 0.35 0.45"/>
    <material name="grid_mat" texture="grid" texrepeat="20 20" reflectance="0.15"/>
    <material name="target_mat" rgba="0.95 0.65 0.2 1.0" specular="0.6" shininess="0.5"/>
  </asset>

  <worldbody>
    <!-- Ground plane -->
    <geom name="floor" type="plane" size="2 2 0.1" material="grid_mat" conaffinity="1" contype="1"/>

    <!-- Manipulable target object for grasp testing -->
    <body name="grasp_target" pos="0.04 0.0 0.18">
      <freejoint name="target_joint"/>
      <geom name="target_geom" type="cylinder" size="0.025 0.05" material="target_mat" mass="0.15" friction="1.2 0.05 0.001"/>
    </body>
  </worldbody>
</mujoco>
