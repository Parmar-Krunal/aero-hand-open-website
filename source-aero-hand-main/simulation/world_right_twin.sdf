<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
  <!--
    Aero Hand Open — Digital Twin World (Right Hand)
    =================================================
    Extends world_right.sdf with:
      • JointPositionController plugins on all 16 joints (for bridge commands)
      • JointStatePublisher plugin → /model/.../joint_state (for mirror mode)
      • 5 logical FSR sensor topics  (bridge publishes force data here)
      • GUI overhead camera for inspection

    Launch:
      export GZ_SIM_RESOURCE_PATH="$PWD/simulation/models"
      gz sim -r simulation/world_right_twin.sdf

    Then in a second terminal:
      python simulation/digital_twin_bridge.py --port /dev/ttyACM0 --hand right

    For dry-run (no hardware):
      python simulation/digital_twin_bridge.py --dry-run --hand right
  -->
  <world name="aero_hand_right_twin">

    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core Gazebo plugins -->
    <plugin name="gz::sim::systems::Physics"          filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands"     filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact"          filename="gz-sim-contact-system"/>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>4 4</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>4 4</size></plane></geometry>
          <material>
            <ambient>0.1 0.1 0.12 1</ambient>
            <diffuse>0.12 0.12 0.16 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ambient light -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 -0.4 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <light name="fill_light" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 5 0 0.5 3.14</pose>
      <diffuse>0.3 0.4 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.5 -0.1 -0.5</direction>
    </light>

    <!-- Aero Hand Open right model -->
    <include>
      <uri>model://aero_hand_open_right</uri>
      <name>aero_hand_open_right</name>
      <pose relative_to="world">0 0 0.12 0 0 0</pose>

      <!-- ─── Joint Position Controllers (all 16 joints) ─────────────── -->
      <!-- Bridge publishes to: /model/aero_hand_open_right/joint/<name>/0/cmd_pos -->

      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>right_thumb_cmc_abd</joint_name>
        <topic>/model/aero_hand_open_right/joint/right_thumb_cmc_abd/0/cmd_pos</topic>
        <p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain><i_max>5</i_max><i_min>-5</i_min><cmd_max>10</cmd_max><cmd_min>-10</cmd_min>
      </plugin>
      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>right_thumb_cmc_flex</joint_name>
        <topic>/model/aero_hand_open_right/joint/right_thumb_cmc_flex/0/cmd_pos</topic>
        <p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain><i_max>5</i_max><i_min>-5</i_min><cmd_max>10</cmd_max><cmd_min>-10</cmd_min>
      </plugin>
      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>right_thumb_mcp</joint_name>
        <topic>/model/aero_hand_open_right/joint/right_thumb_mcp/0/cmd_pos</topic>
        <p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain><i_max>5</i_max><i_min>-5</i_min><cmd_max>10</cmd_max><cmd_min>-10</cmd_min>
      </plugin>
      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>right_thumb_ip</joint_name>
        <topic>/model/aero_hand_open_right/joint/right_thumb_ip/0/cmd_pos</topic>
        <p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain><i_max>5</i_max><i_min>-5</i_min><cmd_max>10</cmd_max><cmd_min>-10</cmd_min>
      </plugin>

      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>right_index_mcp_flex</joint_name>
        <topic>/model/aero_hand_open_right/joint/right_index_mcp_flex/0/cmd_pos</topic>
        <p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain><i_max>5</i_max><i_min>-5</i_min><cmd_max>10</cmd_max><cmd_min>-10</cmd_min>
      </plugin>
      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>right_index_pip</joint_name>
        <topic>/model/aero_hand_open_right/joint/right_index_pip/0/cmd_pos</topic>
        <p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain><i_max>5</i_max><i_min>-5</i_min><cmd_max>10</cmd_max><cmd_min>-10</cmd_min>
      </plugin>
      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>right_index_dip</joint_name>
        <topic>/model/aero_hand_open_right/joint/right_index_dip/0/cmd_pos</topic>
        <p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain><i_max>5</i_max><i_min>-5</i_min><cmd_max>10</cmd_max><cmd_min>-10</cmd_min>
      </plugin>

      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>right_middle_mcp_flex</joint_name>
        <topic>/model/aero_hand_open_right/joint/right_middle_mcp_flex/0/cmd_pos</topic>
        <p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain><i_max>5</i_max><i_min>-5</i_min><cmd_max>10</cmd_max><cmd_min>-10</cmd_min>
      </plugin>
      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>right_middle_pip</joint_name>
        <topic>/model/aero_hand_open_right/joint/right_middle_pip/0/cmd_pos</topic>
        <p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain><i_max>5</i_max><i_min>-5</i_min><cmd_max>10</cmd_max><cmd_min>-10</cmd_min>
      </plugin>
      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>right_middle_dip</joint_name>
        <topic>/model/aero_hand_open_right/joint/right_middle_dip/0/cmd_pos</topic>
        <p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain><i_max>5</i_max><i_min>-5</i_min><cmd_max>10</cmd_max><cmd_min>-10</cmd_min>
      </plugin>

      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>right_ring_mcp_flex</joint_name>
        <topic>/model/aero_hand_open_right/joint/right_ring_mcp_flex/0/cmd_pos</topic>
        <p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain><i_max>5</i_max><i_min>-5</i_min><cmd_max>10</cmd_max><cmd_min>-10</cmd_min>
      </plugin>
      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>right_ring_pip</joint_name>
        <topic>/model/aero_hand_open_right/joint/right_ring_pip/0/cmd_pos</topic>
        <p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain><i_max>5</i_max><i_min>-5</i_min><cmd_max>10</cmd_max><cmd_min>-10</cmd_min>
      </plugin>
      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>right_ring_dip</joint_name>
        <topic>/model/aero_hand_open_right/joint/right_ring_dip/0/cmd_pos</topic>
        <p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain><i_max>5</i_max><i_min>-5</i_min><cmd_max>10</cmd_max><cmd_min>-10</cmd_min>
      </plugin>

      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>right_pinky_mcp_flex</joint_name>
        <topic>/model/aero_hand_open_right/joint/right_pinky_mcp_flex/0/cmd_pos</topic>
        <p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain><i_max>5</i_max><i_min>-5</i_min><cmd_max>10</cmd_max><cmd_min>-10</cmd_min>
      </plugin>
      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>right_pinky_pip</joint_name>
        <topic>/model/aero_hand_open_right/joint/right_pinky_pip/0/cmd_pos</topic>
        <p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain><i_max>5</i_max><i_min>-5</i_min><cmd_max>10</cmd_max><cmd_min>-10</cmd_min>
      </plugin>
      <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
        <joint_name>right_pinky_dip</joint_name>
        <topic>/model/aero_hand_open_right/joint/right_pinky_dip/0/cmd_pos</topic>
        <p_gain>20</p_gain><i_gain>0.1</i_gain><d_gain>0.5</d_gain><i_max>5</i_max><i_min>-5</i_min><cmd_max>10</cmd_max><cmd_min>-10</cmd_min>
      </plugin>

      <!-- ─── Joint State Publisher (for mirror mode: Gazebo → real hand) ── -->
      <!-- Publishes to: /model/aero_hand_open_right/joint_state -->
      <plugin name="gz::sim::systems::JointStatePublisher" filename="gz-sim-joint-state-publisher-system">
        <topic>/model/aero_hand_open_right/joint_state</topic>
        <joint_name>right_thumb_cmc_abd</joint_name>
        <joint_name>right_thumb_cmc_flex</joint_name>
        <joint_name>right_thumb_mcp</joint_name>
        <joint_name>right_thumb_ip</joint_name>
        <joint_name>right_index_mcp_flex</joint_name>
        <joint_name>right_index_pip</joint_name>
        <joint_name>right_index_dip</joint_name>
        <joint_name>right_middle_mcp_flex</joint_name>
        <joint_name>right_middle_pip</joint_name>
        <joint_name>right_middle_dip</joint_name>
        <joint_name>right_ring_mcp_flex</joint_name>
        <joint_name>right_ring_pip</joint_name>
        <joint_name>right_ring_dip</joint_name>
        <joint_name>right_pinky_mcp_flex</joint_name>
        <joint_name>right_pinky_pip</joint_name>
        <joint_name>right_pinky_dip</joint_name>
      </plugin>

    </include>

    <!-- Fixed mount (simulator fixture — not a physical part) -->
    <joint name="right_hand_base_mount" type="fixed">
      <parent>world</parent>
      <child>aero_hand_open_right::right_base_link</child>
    </joint>

    <!-- ─── Logical FSR sensor topics ──────────────────────────────────────
         The bridge publishes Double messages to these topics.
         The FSR node names below are for reference only — they are not
         physical SDF sensor elements because Gazebo does not natively
         model FSR resistors. Force data arrives externally from the bridge.

         Topics written by digital_twin_bridge.py:
           /model/aero_hand_open_right/sensor/thumb_fsr/force   (Double, Newtons)
           /model/aero_hand_open_right/sensor/index_fsr/force
           /model/aero_hand_open_right/sensor/middle_fsr/force
           /model/aero_hand_open_right/sensor/ring_fsr/force
           /model/aero_hand_open_right/sensor/pinky_fsr/force

         To echo a sensor in a terminal:
           gz topic -e -t /model/aero_hand_open_right/sensor/index_fsr/force
    ────────────────────────────────────────────────────────────────────── -->

    <!-- GUI camera -->
    <gui fullscreen="false">
      <plugin filename="GzScene3D" name="3D View">
        <gz-gui>
          <title>Aero Hand Digital Twin</title>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.2 0.2 0.2</ambient_light>
        <background_color>0.05 0.08 0.15</background_color>
        <camera_pose>0.28 -0.22 0.28 0 0.45 0.8</camera_pose>
        <camera_clip>
          <near>0.001</near>
          <far>10</far>
        </camera_clip>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <property key="showTitleBar" type="bool">false</property>
          <property key="resizable" type="bool">false</property>
          <property key="height" type="double">72</property>
          <property key="z" type="double">1</property>
          <property key="state" type="string">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>
    </gui>

  </world>
</sdf>
